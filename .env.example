# Server
PORT=3000

# PostgreSQL / Supabase (get from: Project Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Admin Panel (set this to a random secret path — e.g., "xk9a4m-panel")
ADMIN_PATH=your-secret-admin-path
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your-secure-password-here

# JWT (generate a long random string)
JWT_SECRET=your-very-long-random-jwt-secret-here

# Groq AI Chat
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_MODEL=llama-3.3-70b-versatile

# Site
SITE_NAME=AdvaySocialSuite
